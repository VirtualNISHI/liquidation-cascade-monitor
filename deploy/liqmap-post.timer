[Unit]
Description=Run liqmap-post every 2 hours (12/day)

[Timer]
# Every 2h. Assumes the server clock is UTC -> 00,02,04,06,08,10,12,14,16,18,20,22 UTC
# (= JST 09,11,13,15,17,19,21,23,01,03,05,07). Adjust if the server is on another timezone.
OnCalendar=*-*-* 00/2:00:00
RandomizedDelaySec=120
Persistent=true
Unit=liqmap-post.service

[Install]
WantedBy=timers.target
